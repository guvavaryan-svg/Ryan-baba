   start_balance = AccountInfoDouble(ACCOUNT_BALANCE);
   start_equity = AccountInfoDouble(ACCOUNT_EQUITY); // FIX 1
   last_day = TimeDay(TimeCurrent());
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(50);
